#!/usr/bin/env bash
set -euo pipefail

IMAGE_HOME="/home/remio"

: "${HOME:=$IMAGE_HOME}"
: "${REMIO_HOME:=${HOME}/.remio}"
: "${REMIO_LISTEN:=0.0.0.0:7676}"
: "${REMIO_WEB_UI_ENABLED:=true}"
: "${REMIO_LOG_LEVEL:=info}"
: "${REMIO_LOG_FORMAT:=json}"
: "${CLAUDE_CONFIG_DIR:=${HOME}/.claude}"
: "${CODEX_HOME:=${HOME}/.codex}"
: "${XDG_CONFIG_HOME:=${HOME}/.config}"
: "${XDG_DATA_HOME:=${HOME}/.local/share}"
: "${XDG_STATE_HOME:=${HOME}/.local/state}"
: "${XDG_CACHE_HOME:=${HOME}/.cache}"

export HOME
export REMIO_HOME
export REMIO_LISTEN
export REMIO_WEB_UI_ENABLED
export REMIO_LOG_LEVEL
export REMIO_LOG_FORMAT
export CLAUDE_CONFIG_DIR
export CODEX_HOME
export XDG_CONFIG_HOME
export XDG_DATA_HOME
export XDG_STATE_HOME
export XDG_CACHE_HOME

ensure_dir() {
  local dir="$1"
  mkdir -p "$dir"
  if [[ "$(id -u)" == "0" ]]; then
    local owner
    owner="$(stat -c "%u" "$dir")"
    if [[ "$owner" == "0" ]]; then
      chown remio:remio "$dir"
    fi
  fi
}

ensure_dir "$HOME"
ensure_dir "$REMIO_HOME"
ensure_dir "$CLAUDE_CONFIG_DIR"
ensure_dir "$CODEX_HOME"
ensure_dir "$XDG_CONFIG_HOME"
ensure_dir "$XDG_DATA_HOME"
ensure_dir "$XDG_STATE_HOME"
ensure_dir "$XDG_CACHE_HOME"

if [[ "$#" -gt 0 ]]; then
  if [[ "$(id -u)" == "0" ]]; then
    exec gosu remio "$@"
  fi
  exec "$@"
fi

if [[ -z "${REMIO_PASSWORD:-}" ]]; then
  {
    echo "[remio] WARNING: REMIO_PASSWORD is not set."
    echo "[remio] The daemon accepts unauthenticated control connections from any client that can reach it."
    echo "[remio] Set REMIO_PASSWORD for any published port or network-reachable deployment."
  } >&2
fi

if [[ ! -f /etc/remio-server-entry ]]; then
  echo "[remio] FATAL: /etc/remio-server-entry is missing." >&2
  exit 1
fi

entry="$(cat /etc/remio-server-entry)"
echo "[remio] starting daemon on ${REMIO_LISTEN} with web UI ${REMIO_WEB_UI_ENABLED}"
if [[ "$(id -u)" == "0" ]]; then
  exec gosu remio node "$entry"
fi
exec node "$entry"
